{
  "name": "tecspaze-community",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TECSPAZE Community - Minimalistische Community-App",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "android:build": "npm run build && npx cap sync android && npx cap open android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:copy": "npx cap copy android",
    "android:add": "npx cap add android"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "@vitejs/plugin-react": "^5.0.1",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "i18next": "^23.7.0",
    "i18next-browser-languagedetector": "^7.2.2",
    "nanoid": "^5.1.16",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.0.0",
    "react-router-dom": "^6.20.0",
    "zustand": "^4.4.0"
  },
  "overrides": {
    "uuid": "^9.0.0"
  }
}
